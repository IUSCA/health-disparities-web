model log {
  id                Int            @id @default(autoincrement())
  timestamp         DateTime       @default(now()) @db.Timestamp(6)
  message           String
  level             String
  worker_process_id Int
  worker_log        worker_process @relation(fields: [worker_process_id], references: [id], onDelete: Cascade)

  @@index([worker_process_id])
}

model worker_process {
  id          Int      @id @default(autoincrement())
  pid         Int
  task_id     String
  step        String
  workflow_id String
  tags        Json?
  start_time  DateTime @default(now()) @db.Timestamp(6)
  hostname    String
  logs        log[]
}

model about {
  id                 Int      @id @default(autoincrement())
  html               String
  created_at         DateTime @default(now()) @db.Timestamp(6)
  last_updated_by    user     @relation(fields: [last_updated_by_id], references: [id])
  last_updated_by_id Int
}

enum access_type {
  BROWSER
  SLATE_SCRATCH
}

/// This table is a partition table and requires additional setup for migrations. Visit https://pris.ly/d/partition-tables for more info.
model variant {
  chr        Int     @db.SmallInt
  position   BigInt
  ref        String
  alt        String
  source_id  Int
  source     source  @relation(fields: [source_id], references: [id])
  phase      Boolean
  is_imputed Boolean
  genotype   Int[]   @db.SmallInt
  dosage     Int[]   @db.SmallInt

  @@id([chr, position, ref, alt, source_id])
}

/// This table is a partition table.
model annotation {
  chr           Int      @db.SmallInt
  position      BigInt
  ref           String
  alt           String
  func          String?
  genes         String[] // Array to store genes associated with each variant
  exonic_func   String?
  aa_change     String?
  af_afr        Float?
  af_sas        Float?
  af_amr        Float?
  af_eas        Float?
  af_nfe        Float?
  af_fin        Float?
  af_asj        Float?
  af_oth        Float?
  cln_allele_id Int?
  cln_dis_db    String?
  cln_dn        String?
  cln_hgvs      String?
  cln_rev_stat  String?
  cln_sig       String?
  cln_vc        String?
  cln_vcso      String?
  cln_geneinfo  String?
  cln_mc        String?
  cadd_phred    Float?
  revel_max     Float?
  polyphen_max  Float?
  sift_max      Float?

  @@id([chr, position, ref, alt])
}

model gene {
  name String @id
}

model source {
  id                   Int                    @id @default(autoincrement())
  name                 String
  build                String
  description          String?
  created_at           DateTime               @default(now()) @db.Timestamp(6)
  published            Boolean                @default(false)
  author_id            Int?
  author               user?                  @relation(fields: [author_id], references: [id])
  variant              variant[]
  genotype_set         genotype_set[]
  participant_genotype participant_genotype[]
}

model snapshot {
  id             Int              @id @default(autoincrement())
  name           String
  description    String?
  timestamp      DateTime         @default(now()) @db.Timestamp(6)
  published      Boolean          @default(false)
  author_id      Int?
  author         user?            @relation(fields: [author_id], references: [id])
  enrolls        participant[]    @relation("enrolls")
  disenrolls     participant[]    @relation("disenrolls")
  phenotype_file phenotype_file[]
  genotype_set   genotype_set[]

  @@index([timestamp])
}

model protocol {
  id           Int                    @id @default(autoincrement())
  name         String
  description  String?
  created_at   DateTime               @default(now()) @db.Timestamp(6)
  author_id    Int?
  author       user?                  @relation(fields: [author_id], references: [id])
  users        user_protocol[]
  participants participant_protocol[]
}

model user_protocol {
  user        user     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  protocol    protocol @relation(fields: [protocol_id], references: [id], onDelete: Cascade)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  user_id     Int
  protocol_id Int

  @@id([user_id, protocol_id])
}

model participant_protocol {
  participant    participant @relation(fields: [participant_id], references: [id], onDelete: Cascade)
  protocol       protocol    @relation(fields: [protocol_id], references: [id], onDelete: Cascade)
  created_at     DateTime    @default(now()) @db.Timestamp(6)
  participant_id Int
  protocol_id    Int

  @@id([participant_id, protocol_id])
}

model genotype_set {
  id          Int               @id @default(autoincrement())
  name        String
  source_id   Int
  source      source            @relation(fields: [source_id], references: [id])
  snapshot_id Int
  snapshot    snapshot          @relation(fields: [snapshot_id], references: [id])
  path        String
  description String?
  samples     genotype_sample[]
  files       genotype_file[]

  @@unique([name, snapshot_id, source_id])
}

model genotype_file {
  id          Int          @id @default(autoincrement())
  name        String
  chr         Int          @db.SmallInt
  path        String
  description String?
  md5         String
  size        BigInt
  set_id      Int
  set         genotype_set @relation(fields: [set_id], references: [id])

  @@unique([name, set_id])
}

model genotype_sample {
  sample         String
  set            genotype_set @relation(fields: [set_id], references: [id])
  set_id         Int
  participant_id Int?
  participant    participant? @relation(fields: [participant_id], references: [id])
  description    String?

  @@id([set_id, sample])
}

model phenotype_file {
  id          Int      @id @default(autoincrement())
  name        String
  path        String
  description String?
  md5         String
  size        BigInt
  snapshot_id Int
  snapshot    snapshot @relation(fields: [snapshot_id], references: [id])
}

model query_analytics {
  id              Int      @id @default(autoincrement())
  query           Json
  sql             String
  values          Json
  run_at          DateTime @default(now()) @db.Timestamp(6)
  author_username String
  author          user     @relation(fields: [author_username], references: [username])
  execution_time  Float
}

/// This table is a partition table (partition of partitions).
// first level partition - snapshot_id
// second level partition - chr
model genotype_stats {
  chr           Int     @db.SmallInt
  position      BigInt
  ref           String
  alt           String
  source_id     Int
  snapshot_id   Int
  protocol_id   Int
  phase         Boolean
  is_imputed    Boolean
  missing       Int
  c0            Int
  c1            Int
  c2            Int
  c3            Int
  allele_number Int
  allele_count  Int
  allele_freq   Float

  @@id([chr, position, ref, alt, source_id, snapshot_id, protocol_id])
}

// prisma is unable to recognize nested partitions. 
// it thinks genotype_stats_snapshot_1 partition is a table and tries to drop it
// to prevent it from dropping, we need to create a model with the same name and add @@ignore directive
// this has to be done for every nested partition created. ex: genotype_stats_snapshot_2, genotype_stats_snapshot_3, etc.
model genotype_stats_snapshot_1 {
  chr           Int     @db.SmallInt
  position      BigInt
  ref           String
  alt           String
  source_id     Int
  snapshot_id   Int
  protocol_id   Int
  phase         Boolean
  is_imputed    Boolean
  missing       Int
  c0            Int
  c1            Int
  c2            Int
  c3            Int
  allele_number Int
  allele_count  Int
  allele_freq   Float

  @@id([chr, position, ref, alt, source_id, snapshot_id, protocol_id])
  @@ignore
}

view gt_stats_annotations {
  chr           Int     @db.SmallInt
  position      BigInt
  ref           String
  alt           String
  source_id     Int
  snapshot_id   Int
  protocol_id   Int
  phase         Boolean
  missing       Int
  c0            Int
  c1            Int
  c2            Int
  c3            Int
  allele_number Int
  allele_count  Int
  allele_freq   Float
  is_imputed    Boolean

  func          String?
  genes         String[]
  exonic_func   String?
  aa_change     String?
  af_afr        Float?
  af_sas        Float?
  af_amr        Float?
  af_eas        Float?
  af_nfe        Float?
  af_fin        Float?
  af_asj        Float?
  af_oth        Float?
  cln_allele_id Int?
  cln_dis_db    String?
  cln_dn        String?
  cln_hgvs      String?
  cln_rev_stat  String?
  cln_sig       String?
  cln_vc        String?
  cln_vcso      String?
  cln_geneinfo  String?
  cln_mc        String?
  cadd_phred    Float?
  revel_max     Float?
  polyphen_max  Float?
  sift_max      Float?

  @@id([chr, position, ref, alt])
}

model ncbiRefSeqCurated {
  id           Int      @id @default(autoincrement())
  name         String
  name2        String
  chr          Int      @db.SmallInt
  strand       String
  txStart      BigInt
  txEnd        BigInt
  cdsStart     BigInt
  cdsEnd       BigInt
  exonCount    Int
  exonStarts   Int[]
  exonEnds     Int[]
  score        Int?
  cdsStartStat cds_type
  cdsEndStat   cds_type
  exonFrames   Int[]
  build        String

  @@index([chr, txStart, txEnd])
  @@index([name2])
}

enum cds_type {
  none
  unk
  incmpl
  cmpl
}

model concept {
  concept_id         Int                    @id
  concept_name       String
  domain_id          String
  vocabulary_id      String
  concept_class_id   String
  standard_concept   String?
  concept_code       String
  valid_start_date   DateTime?
  valid_end_date     DateTime?
  invalid_reason     String?
  concept_synonyms   concept_synonym[]
  left_relationship  concept_relationship[] @relation("left_relationship")
  right_relationship concept_relationship[] @relation("right_relationship")

  // @@index([concept_name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([vocabulary_id])
  @@index([concept_class_id])
  @@index([concept_code])
}

model concept_relationship {
  concept_id_1     Int
  concept_id_2     Int
  relationship_id  String
  valid_start_date DateTime?
  valid_end_date   DateTime?
  invalid_reason   String?
  concept1         concept   @relation(name: "left_relationship", fields: [concept_id_1], references: [concept_id])
  concept2         concept   @relation(name: "right_relationship", fields: [concept_id_2], references: [concept_id])

  @@id([concept_id_1, concept_id_2, relationship_id])
}

model concept_synonym {
  concept_id           Int
  concept_synonym_name String // gin gin_trgm_ops
  language_concept_id  Int
  concept              concept @relation(fields: [concept_id], references: [concept_id])

  @@id([concept_id, concept_synonym_name, language_concept_id])
  // @@index([concept_synonym_name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([concept_id])
}

view demographic_extended {
  id             Int       @id @default(autoincrement())
  gender         String
  race           String
  ethnicity      String?
  max_enc_date   DateTime
  dob            DateTime
  enroll_date    DateTime?
  participant_id Int
  age            Int
  weight         Decimal?
  height         Decimal?
  bmi            Decimal?
}

model api_key {
  id                  Int             @id @default(autoincrement())
  name                String
  description         String?
  user_id             Int
  key                 String          @unique
  secret              Bytes           @db.ByteA
  created_at          DateTime        @default(now()) @db.Timestamp(6)
  expires_at          DateTime
  revoked             Boolean         @default(false)
  revoked_at          DateTime?
  revoker_username    String?
  user                user            @relation(fields: [user_id], references: [id], onDelete: Cascade, name: "api_key_user")
  audit_logs          api_audit_log[]
  scopes              api_key_scope[]
  revoker             user?           @relation(fields: [revoker_username], references: [username], name: "api_key_revoker")
  whitelisted_subnets subnet[]
}

model subnet {
  id         Int     @id @default(autoincrement())
  subnet     String  @db.Inet
  api_key_id Int
  api_key    api_key @relation(fields: [api_key_id], references: [id], onDelete: Cascade)

  @@unique([subnet, api_key_id])
}

model scope {
  id            Int             @id @default(autoincrement())
  name          String          @unique // e.g. "read:datasets" {action}:{resource}
  resource      String
  action        String
  description   String?
  api_keys      api_key_scope[]
  api_audit_log api_audit_log[]

  @@unique([resource, action])
}

model api_key_scope {
  api_key_id Int
  scope_id   Int
  api_key    api_key @relation(fields: [api_key_id], references: [id], onDelete: Cascade)
  scope      scope   @relation(fields: [scope_id], references: [id], onDelete: Cascade)

  @@id([api_key_id, scope_id])
}

model api_audit_log {
  id            Int      @id @default(autoincrement())
  api_key_id    Int
  endpoint      String
  accessed_at   DateTime @default(now()) @db.Timestamp(6)
  http_method   String
  ip_address    String?  @db.Inet
  status_code   Int?
  scope_id      Int?
  response_time Int? // in milliseconds
  request_body  String? // Optionally log the request body for debugging
  response_body String? // Optionally log the response body for debugging

  api_key api_key @relation(fields: [api_key_id], references: [id], onDelete: Cascade)
  scope   scope?  @relation(fields: [scope_id], references: [id], onDelete: Cascade)

  @@index([api_key_id])
}

model cohort_access_request {
  id            Int           @id @default(autoincrement())
  requester_id  Int // User who made the request
  cohort_id     String        @db.Uuid
  status        RequestStatus @default(PENDING) // PENDING, APPROVED, REJECTED
  reviewer_id   Int? // Reviewer who made the decision
  decision_date DateTime? // When the decision was made
  notes         String?
  created_at    DateTime      @default(now()) @db.Timestamp(6)
  updated_at    DateTime      @default(now()) @updatedAt @db.Timestamp(6)

  requester user   @relation(fields: [requester_id], references: [id], name: "cohort_access_requester")
  cohort    cohort @relation(fields: [cohort_id], references: [id])
  reviewer  user?  @relation(fields: [reviewer_id], references: [id], name: "cohort_access_reviewer")

  @@index([cohort_id])
  @@index([requester_id])
  @@index([status])
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}
