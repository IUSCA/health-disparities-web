  concept1         concept   @relation(name: "left_relationship", fields: [concept_id_1], references: [concept_id])
  concept2         concept   @relation(name: "right_relationship", fields: [concept_id_2], references: [concept_id])

  @@id([concept_id_1, concept_id_2, relationship_id])
}

model concept_synonym {
