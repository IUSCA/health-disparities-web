model api_audit_log {
  id            Int      @id @default(autoincrement())
  api_key_id    Int
  endpoint      String
  accessed_at   DateTime @default(now()) @db.Timestamp(6)
  http_method   String
  ip_address    String?  @db.Inet
  status_code   Int?
  scope_id      Int?
  response_time Int? // in milliseconds
  request_body  String? // Optionally log the request body for debugging
  response_body String? // Optionally log the response body for debugging

  api_key api_key @relation(fields: [api_key_id], references: [id], onDelete: Cascade)
  scope   scope?  @relation(fields: [scope_id], references: [id], onDelete: Cascade)

  @@index([api_key_id])
}

// Partial unique index on requester_id and cohort_id where status is INITIATED, PENDING or APPROVED
// This ensures that a user can only have one pending or approved access request for a specific cohort
// CREATE UNIQUE INDEX active_request_unique
// ON cohort_access_request(requester_id, cohort_id)
// WHERE status IN ('INITIATED', 'PENDING', 'APPROVED');
model cohort_access_request {
  id                 Int           @id @default(autoincrement())
  requester_id       Int // User who made the request
  cohort_id          String        @db.Uuid
  status             RequestStatus @default(INITIATED)
  decision_date      DateTime? // When the last decision was made
  notes              String?
  created_at         DateTime      @default(now()) @db.Timestamp(6)
  updated_at         DateTime      @default(now()) @updatedAt @db.Timestamp(6)
  request_id         String        @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expires_at         DateTime? // When the request expires
  last_synced_at     DateTime? // When the request was last synced with the upstream system
  upstream_record_id String? // ID of the record in the upstream system
  version            Int           @default(1) // Version to implement optimistic locking

  requester   user                       @relation(fields: [requester_id], references: [id], name: "access_requester", onDelete: Cascade)
  cohort      cohort                     @relation(fields: [cohort_id], references: [id], onDelete: Cascade)
  stages      access_request_stage[]
  audit_logs  access_request_audit_log[]
  cohort_view cohort_view                @relation(fields: [cohort_id], references: [id], name: "cohort_view", map: "cohort_access_request_cohort_view_id_fkey")
}

model access_request_stage_definition {
  id          String  @id
  name        String
  order       Int // controls order across requests
  description String?

  stages access_request_stage[]
}

model access_request_stage {
  id                Int           @id @default(autoincrement())
  access_request_id Int
  definition_id     String
  status            RequestStatus @default(PENDING)
  metadata          Json?
  decision_date     DateTime?
  updated_at        DateTime      @default(now()) @updatedAt @db.Timestamp(6)

  access_request cohort_access_request           @relation(fields: [access_request_id], references: [id], onDelete: Cascade)
  definition     access_request_stage_definition @relation(fields: [definition_id], references: [id], onDelete: Cascade)
  audit_logs     access_request_audit_log[]

  @@unique([access_request_id, definition_id])
  @@index([access_request_id])
}

model access_request_audit_log {
  id                Int      @id @default(autoincrement())
  access_request_id Int?
  stage_id          Int?
  changed_by_id     Int
  action            String
  change_source     String // user, admin, system, upstream
  timestamp         DateTime @default(now()) @db.Timestamp(6)
  old_data          Json?
  new_data          Json?
  reason            String?

  access_request cohort_access_request? @relation(fields: [access_request_id], references: [id], onDelete: Cascade)
  stage          access_request_stage?  @relation(fields: [stage_id], references: [id], onDelete: Cascade)
  changed_by     user                   @relation(fields: [changed_by_id], references: [id], onDelete: Cascade)

  @@index([access_request_id])
}

