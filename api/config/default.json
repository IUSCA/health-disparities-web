{
  "mode": "default",
  "app_id": "biobank-dev.sca.iu.edu",
  "express": {
    "port": 3030,
    "host": "localhost"
  },
  "logger": {
    "level": "debug"
  },
  "typesense": {
    "host": "typesense",
    "port": "8108",
    "protocol": "http",
    "api_key": "xyz"
  },
  "workflow_server": {
    "base_url": "http://127.0.0.1:5001",
    "auth_token": ""
  },
  "auth": {
    "mode": "dev",
    "jwt": {
      "iss": "localhost",
      "ttl_milliseconds": 604800000,
      "pub": "keys/auth.pub",
      "key": "keys/auth.key",
      "sign_algorithm": "RS256"
    },
    "google": {
      "enabled": false,
      "authorization_endpoint": "https://accounts.google.com/o/oauth2/v2/auth",
      "token_endpoint": "https://oauth2.googleapis.com/token",
      "scope": "openid email",
      "client_id": "",
      "client_secret": ""
    },
    "cilogon": {
      "enabled": false,
      "authorization_endpoint": "https://cilogon.org/authorize",
      "token_endpoint": "https://cilogon.org/oauth2/token",
      "scope": "openid+email",
      "client_id": "",
      "client_secret": ""
    }
  },
  "oauth": {
    "base_url": "",
    "download": {
      "client_id": "",
      "client_secret": "",
      "scope_prefix": "download_file:"
    }
  },
  "download_server": {
    "base_url": ""
  },
  "workflow_registry": {
    "integrated": {
      "description": "An end-to-end workflow to inspect, archive, state and validate a dataset",
      "steps": [
        {
            "name": "await stability",
            "task": "await_stability"
        },
        {
            "name": "inspect",
            "task": "inspect_dataset"
        },
        {
            "name": "archive",
            "task": "archive_dataset"
        },
        {
            "name": "stage",
            "task": "stage_dataset"
        },
        {
            "name": "validate",
            "task": "validate_dataset"
        },
        {
            "name": "setup_download",
            "task": "setup_dataset_download"
        }
    ]
    },
    "stage": {
      "steps": [
        {
          "name": "stage",
          "task": "stage_dataset"
        },
        {
          "name": "validate",
          "task": "validate_dataset"
        },
        {
          "name": "setup_download",
          "task": "setup_dataset_download"
        }
      ]
    },
    "stage_direct": {
      "steps": [
        {
          "name": "stage_direct",
          "task": "stage_dataset_direct",
          "kwargs": {
            "stage_root_dir": "/N/project/INB_mtDNA/data/rawData"
          }
        },
        {
          "name": "validate",
          "task": "validate_dataset"
        }
      ]
    },
    "delete": {
      "steps": [
        {
          "name": "delete",
          "task": "delete_dataset"
        }
      ]
    }
  },
  "dataset_types" : ["RAW_DATA", "DATA_PRODUCT"],
  "system_user": {
    "username": "svc_tasks"
  },
  "variant_search": {
    "gene": {
      "left_padding": 2500,
      "right_padding": 2500
    },
    "genome_build": "hg38"
  },
  "openai": {
    "base_url":"http://rc-156-247.rci.uits.iu.edu/api/v1/chat",
    "api_key": ""
  },
  "e2e": {
    "users": {
      "admin": {
        "username": ""
      },
      "operator": {
        "username": ""
      },
      "user": {
        "username": ""
      }
    }
  },
  "api_keys": {
    "enabled": true,
    "max_valid_days": 90,
    "encryption_key": "",
    "max_per_user": 5
  },
  "contact": {
    "app_admin": "bioloop-ops-l@list.iu.edu"
  }
}