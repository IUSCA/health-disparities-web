{
  "mode": "default",
  "app_id": "biobank-dev.sca.iu.edu",
  "express": {
    "port": 3030,
    "host": "localhost"
  },
  "logger": {
    "level": "debug"
  },
  "typesense": {
    "host": "typesense",
    "port": "8108",
    "protocol": "http",
    "api_key": "xyz"
  },
  "workflow_server": {
    "base_url": "http://127.0.0.1:5001",
    "auth_token": ""
  },
  "auth": {
    "mode": "dev",
    "jwt": {
      "iss": "localhost",
      "ttl_milliseconds": 604800000,
      "pub": "keys/auth.pub",
      "key": "keys/auth.key",
      "sign_algorithm": "RS256"
    },
    "google": {
      "enabled": false,
      "authorization_endpoint": "https://accounts.google.com/o/oauth2/v2/auth",
      "token_endpoint": "https://oauth2.googleapis.com/token",
      "scope": "openid email",
      "client_id": "",
      "client_secret": ""
    },
    "cilogon": {
      "enabled": false,
      "authorization_endpoint": "https://cilogon.org/authorize",
      "token_endpoint": "https://cilogon.org/oauth2/token",
      "scope": "openid+email",
      "client_id": "",
      "client_secret": ""
    },
    "microsoft": {
      "enabled": true,
      "authorization_endpoint": "https://login.microsoftonline.com/common/oauth2/v2.0/authorize",
      "token_endpoint": "https://login.microsoftonline.com/common/oauth2/v2.0/token",
      "scope": "https://graph.microsoft.com/User.Read",
      "client_id": "",
      "client_secret": ""
    },
    "auto_sign_up": {
      "enabled": false,
      "default_role": "user"
    },
    "signup": {
      "default_role": "user",
      "dev_default_role": "admin",
      "jwt": {
        "scope": "signup",
        "ttl_milliseconds": 600000
      },
      "auto_generate_username_if_not_unique": true,
      "max_username_suffix": 999
    }
  },
  "oauth": {
    "base_url": "",
    "download": {
      "client_id": "",
      "client_secret": "",
      "scope_prefix": "download_file:"
    },
    "upload": {
      "scope_prefix": "upload_file:"
    }
  },
  "upload": {
    "path": ""
  },
  "download_server": {
    "base_url": ""
  },
  "workflow_registry": {
    "integrated": {
      "description": "An end-to-end workflow to inspect, archive, state and validate a dataset",
      "steps": [
        {
          "name": "await stability",
          "task": "await_stability"
        },
        {
          "name": "inspect",
          "task": "inspect_dataset"
        },
        {
          "name": "archive",
          "task": "archive_dataset"
        },
        {
          "name": "stage",
          "task": "stage_dataset"
        },
        {
          "name": "validate",
          "task": "validate_dataset"
        },
        {
          "name": "setup_download",
          "task": "setup_dataset_download"
        }
      ]
    },
    "stage": {
      "steps": [
        {
          "name": "stage",
          "task": "stage_dataset"
        },
        {
          "name": "validate",
          "task": "validate_dataset"
        },
        {
          "name": "setup_download",
          "task": "setup_dataset_download"
        }
      ]
    },
    "stage_direct": {
      "steps": [
        {
          "name": "stage_direct",
          "task": "stage_dataset_direct",
          "kwargs": {
            "stage_root_dir": "/N/project/INB_mtDNA/data/rawData"
          }
        },
        {
          "name": "validate",
          "task": "validate_dataset"
        }
      ]
    },
    "delete": {
      "steps": [
        {
          "name": "delete",
          "task": "delete_dataset"
        }
      ]
    },
    "process_dataset_upload": {
      "steps": [
        {
          "name": "Process Dataset Upload",
          "task": "process_dataset_upload"
        }
      ]
    },
    "cancel_dataset_upload": {
      "steps": [
        {
          "name": "Cancel Dataset Upload",
          "task": "cancel_dataset_upload"
        }
      ]
    }

  },
  "dataset_types" : ["RAW_DATA", "DATA_PRODUCT"],
  "system_user": {
    "username": "svc_tasks"
  },
  "variant_search": {
    "gene": {
      "left_padding": 2500,
      "right_padding": 2500
    },
    "genome_build": "hg38"
  },
  "openai": {
    "base_url":"http://rc-156-247.rci.uits.iu.edu/api/v1/chat",
    "api_key": ""
  },
  "e2e": {
    "users": {
      "admin": {
        "username": ""
      },
      "operator": {
        "username": ""
      },
      "user": {
        "username": ""
      }
    }
  },
  "filesystem_search_spaces": "",
  "filesystem": {
    "search_spaces": "",
    "base_dir": {
      "slateScratch": ""
    },
    "mount_dir": {
      "slateScratch": ""
    }
  },
  "restricted_ingestion_dirs": {
    "slateScratch": ""
  },
  "enabled_features": {
    "upload": {
      "enabled_for_roles": []
    },
    "fs": {
      "enabled_for_roles": [""]
    },
    "downloads": true,
    "signup": true,
    "participant_details": false
  },
  "api_keys": {
    "enabled": true,
    "max_valid_days": 90,
    "encryption_key": "",
    "max_per_user": 5,
    "upstream_server_protection": {
      "enabled": true,
      "header_name": "X-Server-Type",
      "allowed_values": [
        "API"
      ]
    }
  },
  "contact": {
    "app_admin": "bioloop-ops-l@list.iu.edu"
  },
  "api_url": "http://localhost:8000",
  "redcap": {
    "base_url": "https://redcap.uits.iu.edu/api",
    "api_token": "",
    "timezone": "America/New_York",
    "polling": {
      "interval_seconds": 30,
      "max_backoff_seconds": 1800,
      "update_batch_size": 100,
      "log_level": "info"
    },
    "form_keys": {
      "requester_email": "email",
      "cohort_id": "cohort_identifier",
      "request_id": "request_id",
      "decision": "final_approval_status",
      "decision_date": "date_final_approval_status",
      "ste_decision": "ste_final_approval_status",
      "ste_decision_date": "ste_date_final_status",
      "ssc_decision": "ssc_final_approval_status",
      "ssc_decision_date": "ssc_date_final_apprv_status",
      "daa_decision": "daa_reviewed",
      "daa_decision_date": "daa_approval_date",


      "approver_email": "who_apprv_catalog_access",
      "revoker_email": "who_revoke_catalog_access",
      "approved_date": "date_catalog_access_apprv",
      "revoked_date": "date_catalog_access_revoked",
      "rejection_reason": "why_catalog_access_revoked"
    },
    "stages": {
      "ste": "STE",
      "ssc": "SSC",
      "daa": "DAA",
      "final_review": "FINAL_REVIEW"
    }
  },
  "access_requests": {
    "expiration": {
      "enabled": false,
      "days": 365
    }
  },
  "institution_types": [
    "Commercial",
    "External Academic",
    "Internal Academic",
    "Non-profit",
    "Other"
  ]
